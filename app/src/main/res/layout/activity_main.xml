<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Copy Text dari Gambar — Floating App"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="1. Beri izin 'Tampil di atas aplikasi lain'\n2. Tekan 'Aktifkan Bubble'\n3. Buka gambar/video/aplikasi apapun, tap bubble → pilih 'Scan Layar' atau 'Pilih Area'\n4. Teks otomatis tercopy ke clipboard"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"/>

    <Button
        android:id="@+id/btnOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="1. Beri Izin Overlay"/>

    <Button
        android:id="@+id/btnProjection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="2. Beri Izin Screenshot"/>

    <Button
        android:id="@+id/btnToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/btn_start"/>

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Status: Belum aktif"
        android:textSize="12sp"
        android:textColor="#666666"/>

</LinearLayout>
